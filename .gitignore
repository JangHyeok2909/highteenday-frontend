# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# 실행 환경 설정은 env/ 아래 한 곳에서만 관리한다 (scripts/with-env.js 가 읽는다).
# 루트의 CRA 기본 env 파일은 쓰지 않는다 — 실수로 생겨도 무시한다.
.env
.env.*

#  env/.env.{local,dev,prod} : 공용 설정,   추적한다
#  env/.env.*.local          : 개인 오버라이드, 추적하지 않는다
# (뒤에 오는 규칙이 이기므로 부정 패턴을 env/*.local 다음에 둔다)
env/*.local
!env/.env.local
!env/.env.dev
!env/.env.prod

npm-debug.log*
yarn-debug.log*
yarn-error.log*
"node_modules/" 
