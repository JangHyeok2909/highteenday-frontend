# ==============================
# prod — 운영. S3 + CloudFront 로 배포되는 빌드가 쓰는 설정.
#   빌드: npm run build:prod   (GitHub Actions 가 이 스크립트를 호출한다)
#   대응 백엔드 프로파일: prod  (application-prod.properties)
#
# npm run start:prod 은 "운영 API 를 보는 로컬 개발 서버"다. 디버깅 용도로만 쓴다.
# 백엔드 prod 의 app.cors.allowed-origins 에는 highteenday.org 도메인만 있어서
# localhost:3000 에서 온 요청은 CORS 로 막힌다 (의도된 동작).
# ==============================

REACT_APP_ENV=prod

REACT_APP_API_BASE_URL=https://api.highteenday.org
REACT_APP_SERVER_ORIGIN=https://api.highteenday.org

# 절대 주소여야 한다. 정적 파일은 CloudFront(www.highteenday.org)가 S3 에서 주고,
# 백엔드는 ALB(api.highteenday.org)가 EC2:8080 으로 넘긴다. CloudFront 에는 /ws 를
# 백엔드로 보내는 동작(behavior)이 없으므로 상대 경로 '/ws' 는 S3 로 떨어진다.
# 백엔드 WebSocketConfig 도 https://www.highteenday.org 를 교차 출처 핸드셰이크
# origin 으로 허용하고 있어, 절대 주소로 붙는 것이 원래 의도된 구성이다.
REACT_APP_WS_URL=https://api.highteenday.org/ws
