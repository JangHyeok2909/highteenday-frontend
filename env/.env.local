# ==============================
# local — 개발자 PC. 백엔드를 직접 localhost:8080 에서 띄워두고 붙는다.
#   실행: npm run start:local
#   대응 백엔드 프로파일: local  (spring.profiles.active=local)
# ==============================

REACT_APP_ENV=local

# 빈 값이면 axios baseURL 이 '' 이 되어 요청이 상대 경로로 나가고,
# package.json 의 proxy(http://localhost:8080)가 백엔드로 중계한다.
# CORS 를 피할 수 있어 local 에서는 이 방식이 가장 편하다.
REACT_APP_API_BASE_URL=

# 브라우저가 백엔드로 직접 이동해야 하는 경우(OAuth 리다이렉트)에 쓰는 절대 주소.
# CRA proxy 는 Accept: text/html 인 페이지 이동 요청을 중계하지 않으므로
# OAuth 는 상대 경로로 쓸 수 없다.
REACT_APP_SERVER_ORIGIN=http://localhost:8080

# WebSocket(SockJS)도 CRA proxy 를 타지 않으므로 절대 주소가 필요하다.
REACT_APP_WS_URL=http://localhost:8080/ws

# dev server
HOST=0.0.0.0
PORT=3000
DANGEROUSLY_DISABLE_HOST_CHECK=true
