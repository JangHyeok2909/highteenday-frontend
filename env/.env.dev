# ==============================
# dev — 배포된 개발 서버 백엔드를 보고 개발/검증한다.
#   실행: npm run start:dev   /   빌드: npm run build:dev
#   대응 백엔드 프로파일: dev  (application-dev.properties)
#
# 주의: 여기서부터는 프론트(localhost:3000)와 백엔드가 서로 다른 origin 이므로
#       CRA proxy 가 아니라 실제 CORS 를 탄다. 백엔드 dev 프로파일의
#       app.cors.allowed-origins(CORS_ORIGINS) 에 http://localhost:3000 이
#       들어 있어야 로그인/쿠키가 동작한다.
# ==============================

REACT_APP_ENV=dev

REACT_APP_API_BASE_URL=https://dev-api.highteenday.org
REACT_APP_SERVER_ORIGIN=https://dev-api.highteenday.org
REACT_APP_WS_URL=https://dev-api.highteenday.org/ws

# dev server
HOST=0.0.0.0
PORT=3000
DANGEROUSLY_DISABLE_HOST_CHECK=true
